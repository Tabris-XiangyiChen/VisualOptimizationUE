# 忽略编译二进制文件 (C++ 项目必须忽略，其他人拉取后重新编译即可)
Binaries/
Plugins/*/Binaries/
Docs_Architecture/

# 忽略所有引擎生成的缓存和中间文件 (这部分体积最大)
DerivedDataCache/
Intermediate/
Plugins/*/Intermediate/
Saved/

# 忽略 Visual Studio 或其他 IDE 的配置文件
.vscode/
.vs/
*.VC.db
*.opendb
*.opensdf
*.sdf
*.sln
*.suo
*.xcodeproj
*.xcworkspace

# 忽略系统生成的隐藏文件
.DS_Store
Thumbs.db
.idea/.idea.FishingMaster/.idea/encodings.xml
.idea/.idea.FishingMaster/.idea/indexLayout.xml
.idea/.idea.FishingMaster/.idea/vcs.xml
Docs_Architecture/AI_Project_Guidelines_And_Architecture.md
Docs_Architecture/Development_Logs/Log_001_Hybrid_UI_System.md

# Local implementation notes generated during Codex work.
/docs/
